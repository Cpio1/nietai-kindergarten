# Основной адрес сайта после подключения домена, например https://<ваш-домен>.edu.kz
# Используется для canonical, sitemap и Open Graph. Без него на Vercel берётся адрес проекта.
NEXT_PUBLIC_SITE_URL=

# Ссылка на папку Google Drive с документами (необязательно).
# Если пусто, используется ссылка по умолчанию из src/content/site.ts.
NEXT_PUBLIC_DOCUMENTS_URL=
